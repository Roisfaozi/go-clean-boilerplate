{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "API Statistics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[2m]))",
          "refId": "A"
        }
      ],
      "title": "Total Requests per Second",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (status) (http_requests_total)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Status Distribution",
      "type": "timeseries"
    },
    {
      "title": "Business & Real-time Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 4,
      "targets": [{ "expr": "app_user_registrations_total", "refId": "A" }],
      "title": "Total Users Registered",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 5,
      "targets": [{ "expr": "app_websocket_active_connections", "refId": "A" }],
      "title": "Active WebSocket Connections",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (status) (app_user_logins_total)",
          "legendFormat": "Login {{status}}",
          "refId": "A"
        }
      ],
      "title": "Login Success vs Failed",
      "type": "timeseries"
    },
    {
      "title": "System Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 7,
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Latency (s)", "refId": "A" }],
      "title": "HTTP p95 Response Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 8,
      "targets": [
        { "expr": "sum by (task_type, status) (app_worker_tasks_total)", "legendFormat": "Worker {{task_type}} ({{status}})", "refId": "A" }
      ],
      "title": "Worker Task Execution Status",
      "type": "timeseries"
    },
    { "id": 9, "type": "row", "title": "Database Pool", "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 } },
    {
      "id": 10, "type": "timeseries", "datasource": "Prometheus", "title": "Connections per pool",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "app_db_pool_open_connections", "legendFormat": "{{instance}} {{db}} open" },
        { "refId": "B", "expr": "app_db_pool_in_use_connections", "legendFormat": "{{instance}} {{db}} in use" },
        { "refId": "C", "expr": "app_db_pool_idle_connections", "legendFormat": "{{instance}} {{db}} idle" },
        { "refId": "D", "expr": "app_db_pool_max_open_connections", "legendFormat": "{{instance}} {{db}} limit" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "datasource": "Prometheus", "title": "Connection waits per second",
      "gridPos": { "x": 12, "y": 28, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(app_db_pool_wait_count_total[5m])", "legendFormat": "{{instance}} {{db}}" }]
    },
    {
      "id": 12, "type": "timeseries", "datasource": "Prometheus", "title": "Connection wait seconds per second",
      "gridPos": { "x": 18, "y": 28, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(app_db_pool_wait_duration_seconds_total[5m])", "legendFormat": "{{instance}} {{db}}" }]
    },
    { "id": 13, "type": "row", "title": "Redis Operations", "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 } },
    {
      "id": 14, "type": "timeseries", "datasource": "Prometheus", "title": "Redis operations per second",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (cmd, status) (rate(app_redis_operations_total[5m]))", "legendFormat": "{{cmd}} {{status}}" }]
    },
    {
      "id": 15, "type": "timeseries", "datasource": "Prometheus", "title": "Redis p95 latency (s)",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, cmd) (rate(app_redis_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{cmd}}" }]
    },
    { "id": 16, "type": "row", "title": "Realtime", "gridPos": { "x": 0, "y": 45, "w": 24, "h": 1 } },
    {
      "id": 17, "type": "timeseries", "datasource": "Prometheus", "title": "Active connections",
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "app_sse_active_connections", "legendFormat": "SSE {{instance}}" },
        { "refId": "B", "expr": "app_ws_active_connections", "legendFormat": "WS {{instance}}" }
      ]
    },
    {
      "id": 18, "type": "timeseries", "datasource": "Prometheus", "title": "WebSocket send drops per second",
      "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(app_ws_send_drops_total[5m])", "legendFormat": "{{instance}}" }]
    },
    { "id": 19, "type": "row", "title": "Async Workers & Outbox", "gridPos": { "x": 0, "y": 54, "w": 24, "h": 1 } },
    {
      "id": 20, "type": "timeseries", "datasource": "Prometheus", "title": "Pending audit entries in last batch",
      "gridPos": { "x": 0, "y": 55, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "app_audit_outbox_pending", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 21, "type": "timeseries", "datasource": "Prometheus", "title": "Oldest pending audit entry (s)",
      "gridPos": { "x": 6, "y": 55, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "app_audit_outbox_oldest_age_seconds", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 22, "type": "timeseries", "datasource": "Prometheus", "title": "Delivery attempts per second",
      "gridPos": { "x": 12, "y": 55, "w": 6, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(app_webhook_deliveries_total[5m]))", "legendFormat": "Webhook {{outcome}}" },
        { "refId": "B", "expr": "sum by (outcome) (rate(app_email_deliveries_total[5m]))", "legendFormat": "Email {{outcome}}" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "datasource": "Prometheus", "title": "Delivery p95 duration (s)",
      "gridPos": { "x": 18, "y": 55, "w": 6, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(app_webhook_delivery_duration_seconds_bucket[5m])))", "legendFormat": "Webhook" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(app_email_delivery_duration_seconds_bucket[5m])))", "legendFormat": "Email" }
      ]
    },
    { "id": 24, "type": "row", "title": "Security & Uploads", "gridPos": { "x": 0, "y": 63, "w": 24, "h": 1 } },
    {
      "id": 25, "type": "timeseries", "datasource": "Prometheus", "title": "Rate-limit rejections per second",
      "gridPos": { "x": 0, "y": 64, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (limiter) (rate(app_rate_limit_rejections_total[5m]))", "legendFormat": "{{limiter}}" }]
    },
    {
      "id": 26, "type": "timeseries", "datasource": "Prometheus", "title": "Storage uploads per second",
      "gridPos": { "x": 6, "y": 64, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (driver, status) (rate(app_storage_uploads_total[5m]))", "legendFormat": "{{driver}} {{status}}" }]
    },
    {
      "id": 27, "type": "timeseries", "datasource": "Prometheus", "title": "TUS completion p95 duration (s)",
      "gridPos": { "x": 12, "y": 64, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, driver) (rate(app_tus_upload_duration_seconds_bucket[5m])))", "legendFormat": "{{driver}}" }]
    },
    {
      "id": 28, "type": "timeseries", "datasource": "Prometheus", "title": "TUS upload p95 size (bytes)",
      "gridPos": { "x": 18, "y": 64, "w": 6, "h": 8 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, driver) (rate(app_tus_upload_size_bytes_bucket[5m])))", "legendFormat": "{{driver}}" }]
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["enterprise", "golang"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Go Clean Boilerplate - Main Dashboard",
  "uid": "main_dashboard",
  "version": 2
}
